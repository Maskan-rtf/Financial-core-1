# Copy to ~/.gapcode/secrets.env (never commit the real file)
# cp tools/gapcode-secrets.env.example ~/.gapcode/secrets.env

# PostgreSQL — same DB you use in DBeaver (Financial-Core)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
FINANCIAL_CORE_DATABASE_URL=postgresql://root:YOUR_PASSWORD@makalu.liara.cloud:30530/FinancialCore?sslmode=disable

# GitHub — create at https://github.com/settings/tokens (repo + read:org scopes)
GITHUB_PERSONAL_ACCESS_TOKEN=
